conky.config = {
    background = false,
    update_interval = 1.0,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    override_utf8_locale = true,

    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 2048,
    imlib_cache_size = 0,

    own_window = true,
    own_window_type = "normal",
    own_window_hints = "",
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 210,
    own_window_colour = "111111",

    minimum_width = 240,
    minimum_height = 110,
    maximum_width = 240,

    alignment = "top_left",
    gap_x = 24,
    gap_y = 52,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,
    border_width = 0,

    use_xft = true,
    font = "Sans:size=8",
    xftalpha = 1.0,

    default_color = "BDBDBD",
    color1 = "77E67D",
    color2 = "83CFFF",
    color3 = "2A2A2A",
    color4 = "F6F6F6",
};

conky.text = [[
${color}zram ${execi 2 /data/personal-projs/ram-cpu-widget/scripts/conky-zram.sh} | temp ${execi 2 /data/personal-projs/ram-cpu-widget/scripts/conky-temp.sh}C | 1000ms
${voffset 2}${color4}${font Sans:bold:size=9}RAM${alignr}${color1}${execi 1 /data/personal-projs/ram-cpu-widget/scripts/conky-ram-pct.sh}%${font}
${color3}${memgraph 14,220 2A2A2A 77E67D -t}
${voffset 4}${color4}${font Sans:bold:size=9}CPU${alignr}${color2}${cpu cpu0}%${font}
${color2}${cpugraph cpu0 14,220 2A2A2A 83CFFF -t}
]];
